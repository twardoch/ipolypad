{
  "name": "ipolypad-js",
  "version": "1.0.1",
  "description": "Convert an image or SVG into a padded polygon hull for CSS shape-outside / text-wrap. Browser-first subset of the ipolypad spec.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svg",
    "polygon",
    "shape-outside",
    "text-wrap",
    "potrace",
    "image",
    "browser"
  ],
  "author": "Adam Twardoch <adam+github@twardoch.com>",
  "license": "Apache-2.0",
  "homepage": "https://code.twardoch.com/ipolypad/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twardoch/ipolypad.git"
  },
  "bugs": {
    "url": "https://github.com/twardoch/ipolypad/issues"
  },
  "dependencies": {
    "esm-potrace-wasm": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
